# upstream: read-only clone, pinned, not ours
upstream/

# Secrets. `.env` holds API tokens and the site origin; `.env.example` is
# committed and holds only names and comments, so the negation has to sit
# directly after the rule or git will not re-include it.
.env
.env.local
.env.*.local
!.env.example

# Debug screenshots. The browser panel writes them into the project directory and
# `git add -A` swept four of them in. A screenshot is evidence for a person, not
# an input to a build, and a repository that accumulates them stops being readable.
.openchamber/screenshots/

# WAL sidecars only. platform/db/shotcraft.db IS committed: it is a deliverable,
# so a reviewer can read the index without running Python (ADR-0002). The
# generator ships alongside it, so the file is always reproducible.
platform/db/*.db-wal
platform/db/*.db-shm

# python
__pycache__/
*.pyc
.venv/
venv/

# scratch files at the repo root. Anything matching this is a throwaway probe
# written to work around a PowerShell quoting problem, not a deliverable --
# `git add -A` swept one into a commit and the next commit had to delete it.
# The real tools all live under platform/.
/_*.py
/_*.txt

# node / site build output
site/node_modules/
site/dist/
node_modules/

# verification screenshots: real evidence, but regenerable on demand and ~100 KB
# each. site/build/*.json IS committed -- the coverage report is the artifact a
# reviewer reads to judge whether a locale is publishable.
site/build/shots/

# os noise
.DS_Store
Thumbs.db
# brand kit render output. Generated by platform/brand_kit.py from brand-kits/*/kit.json.
# Committed never: the kit is source, the rendered tokens are an artefact of it.
brand-out/

# The Remotion working copy: the template plus node_modules, 638 MB. Never
# committed, never committed *into upstream* either -- `platform/render/run.py`
# copies it here precisely because npm install writes to whatever directory it
# runs in and upstream/ is a pinned read-only clone.
platform/render/.work/

# render/out/*.mp4 IS committed. Those are the deliverable -- the portfolio
# footage -- and a report that claims 117 clips with nothing in the tree is a
# report nobody can check. Regenerate with `python platform/render/run.py --render`.

