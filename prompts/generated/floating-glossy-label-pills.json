  "parameters": [
    {
      "ord": 0,
      "variant": null,
      "key": "拍点",
      "typical": "0.200 / 0.483 / 0.688，行程 0.185 / 0.150 / 0.150",
      "feel": "首拍比后两拍慢 23%（含长尾更慢）——这个不均匀是实测来的手感，改成等长会读作机械播片"
    },
    {
      "ord": 1,
      "variant": null,
      "key": "首拍长尾",
      "typical": "0.85×主曲线 + 0.15×`outCubic(0.28)`",
      "feel": "15% 的权重摊在 1.5 倍时长上；权重调到 0.3 以上尾巴会拖得能看出\"还在动\""
    },
    {
      "ord": 2,
      "variant": null,
      "key": "换位曲线",
      "typical": "`E.inOutCubic`",
      "feel": "缓起缓收是关键；换 outQuad（快进慢出）立刻读作被甩过去，走廊的从容感消失"
    },
    {
      "ord": 3,
      "variant": null,
      "key": "开场余量",
      "typical": "左偏 11px，0.19 内 outQuart 归位",
      "feel": "11px 是\"上一拍刚结束\"的暗示量；归零则开场是死的，>30px 会读作又一次换位"
    },
    {
      "ord": 4,
      "variant": null,
      "key": "中心距",
      "typical": "SP=232px（面板 W≈252）",
      "feel": "SP < W 时邻居会压住居中面板边缘；SP 比 W 略小（232 vs 252）正是\"露出一截\"的来源"
    },
    {
      "ord": 5,
      "variant": null,
      "key": "邻位缩放",
      "typical": "`lerp(close, 0.62, 1)`",
      "feel": "0.62 是实测值；>0.75 时主次不分，<0.5 邻居小到读作缩略图而不是同类面板"
    },
    {
      "ord": 6,
      "variant": null,
      "key": "邻位下沉",
      "typical": "面板 `d*80px` / 胶囊 `d*92px`",
      "feel": "两条曲线的差（12px）让胶囊离心时贴住面板顶边；改成同值会看到胶囊悬在面板上方"
    },
    {
      "ord": 7,
      "variant": null,
      "key": "邻位透明/模糊",
      "typical": "opacity 下限 0.78、blur `d*1.3px`",
      "feel": "**邻位必须仍清楚可见**——原片左右始终露着相邻面板边缘；opacity 压到 0.4 或 blur >3px 走廊就断了"
    },
    {
      "ord": 8,
      "variant": null,
      "key": "光标",
      "typical": "0.717 硬现（2f），outQuart 滑到 0.90 后静止",
      "feel": "硬现是\"指针本来就在那\"；给它淡入会读作 UI 元素出现。outQuart 的强减速是鼠标的物理本能"
    },
    {
      "ord": 9,
      "variant": null,
      "key": "内容坐标系",
      "typical": "内部 330×255，整体 `scale(252/330)`",
      "feel": "所有 wireframe 像素值写在 330×255 里，改面板尺寸只改 CS 一处"
    }
  ],
  "pitfalls": [
    {
      "ord": 0,
      "text": "整卡只有一个色相来源：`ACCENT` 及其 `ACCENT_LIGHT` / `ACCENT_DEEP` 三档，加上对应的",
      "critical": false,
      "rules": null
    },
    {
      "ord": 1,
      "text": "例外：表格行的状态色块（淡红/淡绿）与表单的开关（开=蓝 `#2f7de1`）是**保留的功能色**，",
      "critical": false,
      "rules": null
    },
    {
