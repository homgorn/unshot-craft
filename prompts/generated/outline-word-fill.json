  "parameters": [
    {
      "ord": 0,
      "variant": null,
      "key": "收缩",
      "typical": "`scale 3.2 → 1`，窗 10f，outCubic",
      "feel": "3.2 倍是\"从脸前退开\"的量；<2 倍读作普通缩放；窗 >20f 就成了缓慢 zoom，冲击全失"
    },
    {
      "ord": 1,
      "variant": null,
      "key": "字重字号",
      "typical": "48px / **500** / `letter-spacing:.5px`，占画宽约三成",
      "feel": "空心字上 700+ 会让 1px 描边包住一大块空白，读作气球字；500 是空心字的甜点"
    },
    {
      "ord": 2,
      "variant": null,
      "key": "描边",
      "typical": "`1px #565b63`，点亮前预热到灰度 145",
      "feel": "1px 细描边是\"制图\"语汇；2px+ 变涂鸦；预热那一档删了硬切显得没由来"
    },
    {
      "ord": 3,
      "variant": null,
      "key": "虚线圆",
      "typical": "r=88、`dash 6 8`、scale 2.8→1（45f）、自转 `t·18`°",
      "feel": "45f 慢收缩是全片的\"呼吸\"，与 10f 的字收缩形成快慢对比；窗压到 20f 两者撞在一起"
    },
    {
      "ord": 4,
      "variant": null,
      "key": "水平虚线",
      "typical": "`dash 5 7`，从 ±240 内伸 144，窗 0.5→0.72",
      "feel": "内伸终点要停在圆边（不进圆内）；伸满全宽读作十字准星，过头了"
    },
    {
      "ord": 5,
      "variant": null,
      "key": "瞬时填充",
      "typical": "`seg(0.742, 0.762)`（≈0.6f）",
      "feel": "**这一下是全卡的目的**：任何形式的慢扫（>3f）都会把钉子降级成美化动画"
    },
    {
      "ord": 6,
