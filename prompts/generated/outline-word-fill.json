    },
    {
      "ord": 1,
      "heading": "动效核心",
      "window": [
        0.05,
        0.14
      ],
      "frame_hints": [
        10
      ],
      "ease": null,
      "beziers": [],
      "raw": "仅 10f），`scale(lerp(zoom, 3.2, 1))`；同期 `born = seg(t, 0.05, 0.14)`"
    },
    {
      "ord": 2,
      "heading": "动效核心",
      "window": null,
      "frame_hints": [
        10
      ],
      "ease": null,
      "beziers": [],
